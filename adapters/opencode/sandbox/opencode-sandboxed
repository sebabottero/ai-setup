#!/bin/sh
# Generated by ai-setup (install.py --opencode-sandbox). Runs OpenCode inside Anthropic's sandbox-runtime (srt),
# using the settings generated from policy.json plus the project folder you launch it from ($PWD, resolved at launch).
# TO VERIFY: the srt CLI form and settings schema were written offline, from memory; check them against `srt --help`
# and the sandbox-runtime README before relying on this wall.
# srt is not installed by ai-setup: npm install -g @anthropic-ai/sandbox-runtime
BASE={{SETTINGS}}
command -v srt >/dev/null 2>&1 || { echo "opencode-sandboxed: srt not found (npm install -g @anthropic-ai/sandbox-runtime)" >&2; exit 127; }
command -v python3 >/dev/null 2>&1 || { echo "opencode-sandboxed: python3 not found" >&2; exit 127; }
RUN="${TMPDIR:-/tmp}/opencode-srt.$$.json"
trap 'rm -f "$RUN"' EXIT INT TERM
python3 -I -c 'import json, os, sys
c = json.load(open(sys.argv[1]))
w = c["filesystem"]["allowWrite"]
if os.getcwd() not in w:
    w.append(os.getcwd())
json.dump(c, open(sys.argv[2], "w"), indent=2)' "$BASE" "$RUN" || exit 1
srt --settings "$RUN" opencode "$@"
